# Browser-safe Vite variables — set these in Vercel. Never put server secrets in VITE_*.
# Supabase Dashboard → Settings → API → Project URL / anon public key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Railway public backend URL, e.g. https://api-production.up.railway.app
VITE_API_URL=http://localhost:3001

# Server-only variables — set these in Railway, never in Vercel.
# OpenAI Platform → API keys.
OPENAI_API_KEY=your-openai-api-key
# Groq Console → API Keys; required for audio transcription.
GROQ_API_KEY=your-groq-api-key
# Supabase Dashboard → Settings → API → service_role key; backend only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Railway Redis URL; required only when running the WhatsApp BullMQ worker.
REDIS_URL=redis://default:password@host:6379
# Public Vercel site URL allowed by backend CORS (no trailing slash).
FRONTEND_URL=http://localhost:5173
# Railway assigns PORT automatically; this is only for local development.
PORT=3001
NODE_ENV=development
# VERCEL is set automatically by Vercel; do not set it on Railway.
# VERCEL=1

# Generated file expiry in hours (optional, defaults to 24)
FILE_TTL_HOURS=24

# Chromium path for PDF generation (set by nixpacks on Railway)
CHROMIUM_PATH=/usr/bin/chromium

# Meta for Developers → WhatsApp → API Setup / App settings.
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
# IMPORTANT: Must be a secure 32-byte hex string in production to prevent hijacking
WHATSAPP_VERIFY_TOKEN=choose-a-random-webhook-verification-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# Internal worker authentication only. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Do not expose this as a VITE_* variable.
API_SECRET_KEY=your-internal-worker-api-key
# Railway internal URL used by the BullMQ worker to call the backend.
WORKER_API_URL=http://localhost:3001
